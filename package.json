{
  "name": "silo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "benchmark:memory": "pnpm --filter @priemskiyyy/silo build && node --expose-gc scripts/benchmark-memory.mjs",
    "benchmark:runtime": "pnpm --filter @priemskiyyy/silo build && node scripts/benchmark-runtime.mjs",
    "test:memory": "node --expose-gc scripts/verify-memory.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "build:docs": "vitepress build docs && node scripts/build-demo.mjs",
    "dev:docs": "vitepress dev docs",
    "lint:docs": "vue-tsc --noEmit -p docs/tsconfig.json",
    "lint:browser": "tsc --noEmit -p tests/browser",
    "test:browser": "pnpm build && pnpm lint:browser && playwright test -c tests/browser/playwright.config.ts",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm lint:prettier && pnpm test:unit && pnpm test:memory && pnpm -r --filter './examples/*' build",
    "check:release": "pnpm check && pnpm lint:docs && pnpm build:docs && pnpm verify:docs && pnpm test:browser && pnpm test:package && pnpm verify:release",
    "test:examples": "pnpm build && pnpm -r --filter './examples/*' build && playwright test -c examples/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vue/test-utils": "2.5.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "fake-indexeddb": "6.2.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
