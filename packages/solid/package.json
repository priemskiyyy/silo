{
  "name": "@priemskiyyy/silo-solid",
  "version": "0.1.0",
  "description": "Solid bindings for Silo: typed persisted values, scopes, status, and native storage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/silo.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/silo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid --project solid-ssr"
  },
  "peerDependencies": {
    "@priemskiyyy/silo": ">=0.1.0 <0.2",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/silo": "workspace:*"
  },
  "keywords": [
    "solid",
    "storage",
    "persistence",
    "reactive",
    "typescript",
    "silo"
  ],
  "homepage": "https://priemskiyyy.github.io/silo/"
}
