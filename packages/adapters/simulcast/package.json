{
  "name": "@priemskiyyy/silo-simulcast",
  "version": "0.1.0",
  "description": "Simulcast bridge for silo: gives any storage adapter live change notifications over a realtime channel, so a value written on one device updates every other.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/silo.git",
    "directory": "packages/adapters/simulcast"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/silo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project simulcast"
  },
  "peerDependencies": {
    "@priemskiyyy/silo": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/silo": "workspace:*",
    "@priemskiyyy/simulcast": "0.4.0"
  },
  "keywords": [
    "simulcast",
    "realtime",
    "pubsub",
    "cross-device",
    "sync",
    "ably",
    "pusher",
    "centrifugo",
    "storage",
    "persistence",
    "typescript",
    "silo",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/silo/"
}
