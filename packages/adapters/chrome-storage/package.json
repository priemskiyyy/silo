{
  "name": "@priemskiyyy/silo-chrome-storage",
  "version": "0.1.0",
  "description": "chrome.storage adapter for silo: asynchronous persistence in a browser extension's storage area, with changes from other extension contexts observed through onChanged.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/silo.git",
    "directory": "packages/adapters/chrome-storage"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/silo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project chrome-storage"
  },
  "peerDependencies": {
    "@priemskiyyy/silo": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/silo": "workspace:*"
  },
  "keywords": [
    "chrome.storage",
    "browser-extension",
    "webextension",
    "storage",
    "persistence",
    "typescript",
    "silo",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/silo/"
}
