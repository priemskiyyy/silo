{
  "name": "@priemskiyyy/silo-json-file",
  "version": "0.1.0",
  "description": "JSON file adapter for silo: synchronous persistence in one file on disk, for Node command line tools, scripts and Electron's main process.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/silo.git",
    "directory": "packages/adapters/json-file"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/silo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project json-file"
  },
  "peerDependencies": {
    "@priemskiyyy/silo": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/silo": "workspace:*"
  },
  "keywords": [
    "file",
    "json",
    "node",
    "fs",
    "cli",
    "electron",
    "storage",
    "persistence",
    "typescript",
    "silo",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/silo/"
}
